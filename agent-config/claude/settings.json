{
  "env": {
    "VISUAL": "/Users/eddyekofo/.config/nvim/tools/agent_prompt_editor.sh",
    "AGENT_PROMPT_DEBUG": "/tmp/agent-prompt-debug.log"
  },
  "permissions": {
    "allow": [],
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "Monitor",
      "EnterWorktree",
      "ExitWorktree",
      "ListAgents",
      "SendUserFile",
      "EndConversation",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "ReadMcpResourceDirTool",
      "mcp__computer-use",
      "mcp__claude-in-chrome"
    ],
    "defaultMode": "auto"
  },
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "animate": "user-invocable-only",
    "animation-vocabulary": "user-invocable-only",
    "apple-design": "user-invocable-only",
    "apple-hig": "user-invocable-only",
    "ask-eddy": "user-invocable-only",
    "client-site-revamp": "user-invocable-only",
    "code-review": "user-invocable-only",
    "diagnosing-bugs": "user-invocable-only",
    "doctor": "user-invocable-only",
    "emil-design-eng": "user-invocable-only",
    "grill-me": "user-invocable-only",
    "handoff": "user-invocable-only",
    "heal": "user-invocable-only",
    "html-doc": "user-invocable-only",
    "implement": "user-invocable-only",
    "ios-debugger-agent": "user-invocable-only",
    "loop": "user-invocable-only",
    "mattpocock-skill-sync": "user-invocable-only",
    "prototype": "user-invocable-only",
    "quiz-me": "user-invocable-only",
    "refactor": "user-invocable-only",
    "research": "user-invocable-only",
    "review-animations": "user-invocable-only",
    "ship": "user-invocable-only",
    "swift-concurrency-expert": "user-invocable-only",
    "swiftui-liquid-glass": "user-invocable-only",
    "swiftui-performance-audit": "user-invocable-only",
    "swiftui-view-refactor": "user-invocable-only",
    "app-store-changelog": "off",
    "codebase-design": "off",
    "codex-first": "off",
    "domain-modeling": "off",
    "git-guardrails-claude-code": "off",
    "improve-codebase-architecture": "off",
    "project-skill-audit": "off",
    "resolving-merge-conflicts": "off",
    "single-dev-server": "off",
    "tdd": "off",
    "teach": "off",
    "wayfinder": "off",
    "wizard": "off",
    "writing-great-skills": "off"
  },
  "disableBundledSkills": true,
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.dotfiles/tmux/scripts/agent_status.py\" hook --agent claude --event permission",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.dotfiles/tmux/scripts/agent_status.py\" hook --agent claude --event question",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.dotfiles/tmux/scripts/agent_status.py\" hook --agent claude --event permission",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.dotfiles/tmux/scripts/agent_status.py\" hook --agent claude --event session-end",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/closeout.sh\" end",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.dotfiles/tmux/scripts/agent_status.py\" hook --agent claude --event session-start",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/eddyekofo/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.dotfiles/tmux/scripts/agent_status.py\" hook --agent claude --event stop",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/closeout.sh\" capture",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/closeout.sh\" length",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.dotfiles/tmux/scripts/agent_status.py\" hook --agent claude --event failure",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.dotfiles/tmux/scripts/agent_status.py\" hook --agent claude --event prompt",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/closeout.sh\" context",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": false
  },
  "effortLevel": "high",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Primary use of Claude Code**: software development",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: private (github.com/eddyekofo94/BibleStandard, confirmed via gh)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: main is the default branch; no classic branch protection listed and rulesets not queryable here — treat main as protected out of caution",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo (github.com:eddyekofo94/BibleStandard.git) and its remote(s) only — no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar; repo contains tools/reader_architecture_allowlist.json and tools/release_rights_allowlist.json which by name suggest access/rights control lists worth treating as sensitive",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited — e.g. matches `prod-db`, not `producer`)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (iOS app workflow for Bible Standard — grill/plan/build/deliver loop via custom skills and subagents)",
      "**Trusted repos**: any private repository under the `canonfidei` GitHub organisation, checked out beneath `$CANONFIDEI_ROOT` (default `~/Programming/Projects/CanonFidei`) — confidential material (including the allowlist files above) is fine to commit there; secrets and personal/entrusted sensitive data are never cleared into any of them by visibility alone. A repo that is public, or outside that organisation, is not trusted by this rule and gains nothing from sitting in the same folder",
      "**Org-specific CLIs**: None configured — project-local tooling observed (herdr, herdr-goal-done, wt) is repo/workflow tooling, not an org-wide CLI",
      "routine under this project's tools/, .working/, and project/ prefixes for workflow scripts (features_index.py, repo_lock.py, session_worktree.py, workflow_status.py) is expected day-to-day activity in this repo"
    ]
  },
  "disabledMcpServers": [
    "computer-use",
    "claude-in-chrome"
  ]
}
