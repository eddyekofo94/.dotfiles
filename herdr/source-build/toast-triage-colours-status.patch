+    #[test]
+    fn working_pulse_keeps_the_round_dot_and_only_moves_its_colour() {
+        let palette = Palette::catppuccin();
+        let (symbol, trough) = ("●", working_pulse_style(&palette, 0));
+        assert_eq!(state_dot(AgentState::Working, true, &palette).0, symbol);
+        let peak = working_pulse_style(&palette, WORKING_PULSE_PERIOD_MS / 2);
+        assert_ne!(trough.fg, peak.fg);
+        assert_eq!(peak.fg, Some(palette.yellow));
+    }
+
+    #[test]
+    fn working_pulse_never_fades_the_dot_into_the_background() {
+        let palette = Palette::catppuccin();
+        for step in 0..WORKING_PULSE_PERIOD_MS {
+            assert!(working_pulse_intensity(step) >= WORKING_PULSE_FLOOR);
+            assert!(working_pulse_intensity(step) <= 1.0);
+            assert_ne!(
+                working_pulse_style(&palette, step).fg,
+                Some(palette.panel_bg)
+            );
+        }
+    }
+
+    #[test]
+    fn working_pulse_repeats_every_period_and_is_symmetric() {
+        assert_eq!(
+            working_pulse_intensity(0),
+            working_pulse_intensity(WORKING_PULSE_PERIOD_MS)
+        );
+        let quarter = WORKING_PULSE_PERIOD_MS / 4;
+        let three_quarters = 3 * quarter;
+        let delta = working_pulse_intensity(quarter) - working_pulse_intensity(three_quarters);
+        assert!(delta.abs() < 0.01, "breath in and out must match: {delta}");
+    }
+
+    #[test]
+    fn working_pulse_is_sampled_often_enough_by_the_redraw_tick() {
+        let tick = crate::app::WORKING_SPINNER_TICK_INTERVAL.as_millis();
+        assert_eq!(WORKING_PULSE_PERIOD_MS % tick, 0);
+        assert!(
+            WORKING_PULSE_PERIOD_MS / tick >= 10,
+            "too few steps per breath"
+        );
+    }
+
+    #[test]
+    fn working_pulse_falls_back_to_dim_on_a_non_truecolour_palette() {
+        let mut palette = Palette::catppuccin();
+        palette.panel_bg = Color::Black;
+        palette.yellow = Color::Yellow;
+        let trough = working_pulse_style(&palette, 0);
+        let peak = working_pulse_style(&palette, WORKING_PULSE_PERIOD_MS / 2);
+        assert_eq!(trough.fg, Some(Color::Yellow));
+        assert!(trough.add_modifier.contains(Modifier::DIM));
+        assert!(!peak.add_modifier.contains(Modifier::DIM));
+    }
