+// Working keeps the same round dot every other state uses and breathes instead
+// of spinning, so the agent list stays one column of dots rather than one column
+// of dots with a braille glyph in it. The phase is a pure function of wall-clock
+// time: clients blit frames and have no widget layer, so there is nothing to
+// push a phase to — what matters is that some loop keeps asking for a redraw,
+// which is what App::sync_working_spinner_deadline guarantees.
+const WORKING_PULSE_PERIOD_MS: u128 = 1_440;
+// How dim the dot gets at the bottom of the breath, as a fraction of the way
+// from the panel background to the full state colour. Never zero: a dot that
+// vanishes reads as a rendering fault, not as an animation.
+const WORKING_PULSE_FLOOR: f32 = 0.34;
+
+/// Position in the breath, from `WORKING_PULSE_FLOOR` at the trough to 1.0 at
+/// the peak. Cosine rather than a triangle wave because it flattens at both
+/// extremes, which is where the redraw tick's coarse steps would otherwise be
+/// most visible.
+fn working_pulse_intensity(now_ms: u128) -> f32 {
+    let phase = (now_ms % WORKING_PULSE_PERIOD_MS) as f32 / WORKING_PULSE_PERIOD_MS as f32;
+    let wave = (1.0 - (phase * std::f32::consts::TAU).cos()) / 2.0;
+    WORKING_PULSE_FLOOR + (1.0 - WORKING_PULSE_FLOOR) * wave
+}
+
+fn blend_channel(from: u8, to: u8, t: f32) -> u8 {
+    (f32::from(from) + (f32::from(to) - f32::from(from)) * t).round() as u8
+}
+
+/// Mixes `to` over `from`. Returns `None` for any palette whose colours are not
+/// truecolour — a 256-colour or named-ANSI theme has nothing to interpolate.
+fn blend_color(from: Color, to: Color, t: f32) -> Option<Color> {
+    match (from, to) {
+        (Color::Rgb(fr, fg, fb), Color::Rgb(tr, tg, tb)) => Some(Color::Rgb(
+            blend_channel(fr, tr, t),
+            blend_channel(fg, tg, t),
+            blend_channel(fb, tb, t),
+        )),
+        _ => None,
+    }
+}
+
+/// The Working dot's style for this instant. Truecolour palettes breathe the
+/// foreground between the panel background and the state colour; anything else
+/// falls back to toggling DIM, which is coarse but still moves.
+fn working_pulse_style(p: &Palette, now_ms: u128) -> Style {
+    let intensity = working_pulse_intensity(now_ms);
+    match blend_color(p.panel_bg, p.yellow, intensity) {
+        Some(color) => Style::default().fg(color),
+        None if intensity < 0.6 => Style::default().fg(p.yellow).add_modifier(Modifier::DIM),
+        None => Style::default().fg(p.yellow),
+    }
+}
+
+fn now_millis() -> u128 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_millis())
+        .unwrap_or(0)
+}
