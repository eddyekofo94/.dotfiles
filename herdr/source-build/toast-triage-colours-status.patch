+// The default "dots" spinner used by most CLI tools (ora, yarn, cargo, …),
+// one Unicode cell wide so the agent list stays column-aligned.
+const WORKING_SPINNER_FRAMES: [&str; 10] = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
+const WORKING_SPINNER_FRAME_MS: u128 = 80;
+
+fn working_spinner_frame(now_ms: u128) -> &'static str {
+    let index = (now_ms / WORKING_SPINNER_FRAME_MS) as usize % WORKING_SPINNER_FRAMES.len();
+    WORKING_SPINNER_FRAMES[index]
+}
