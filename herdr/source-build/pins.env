# Single source of truth for Herdr's identity on this machine. Everything that
# needs to know which Herdr this is — install.sh, herdr/verify.sh,
# verify_integrations.sh, source-build/build.sh — reads it from here rather than
# hardcoding a version or digest, so an upgrade is one edit to this file (which
# upgrade.sh makes for you) instead of a hunt through six scripts.
HERDR_SOURCE_REPOSITORY=https://github.com/ogulcancelik/herdr.git

# What `herdr --version` prints for the release tracked below.
HERDR_VERSION=0.8.0

# The official upstream release binary for this version: what install.sh
# downloads when no reviewed source build is supplied, and the artifact
# herdr/verify.sh uses as a fixture when it exercises atomic replacement.
HERDR_OFFICIAL_ASSET=herdr-macos-aarch64
HERDR_OFFICIAL_SHA256=d53a9f93fccfdfcc55632927bf51002f5add0aa7990bcdf508ffbd84ac658178
HERDR_SOURCE_TAG=v0.8.0
HERDR_SOURCE_TAG_OBJECT=857196dee1ce98df53efdd3f437aa2ac8a75b608
HERDR_SOURCE_COMMIT=346411fa21afd297f5ed3b3fa56f9e3fbf7654b7
HERDR_RUST_TOOLCHAIN=1.96.1
HERDR_ZIG_VERSION=0.15.2
# The private patch series, in apply order, which must be the order `git diff`
# emits (sorted by path) so the concatenation matches HERDR_PATCH_SHA256 below.
# One file per reviewed change: each can be re-reviewed or dropped on its own at
# the next upstream tag. Each file owns a disjoint set of source paths.
HERDR_PATCH_SERIES="copy-mode-vim-muscle-memory.patch toast-triage-colours-mobile.patch agent-panel-active-highlight.patch toast-triage-colours-status.patch"

HERDR_PATCH_SHA256=b20c48b67c740af90a94ce0bdda90817a35a3b4608875049116439a97de87b5b
HERDR_PATCHED_SOURCE_SHA256=6bfd612e27701d92a836fa047e08535e97ef85aaa4157f080a29e3bc92046eab
HERDR_BINARY_SHA256=36134ca8f1bdc55d1872e7358cc948c1ae1b5cffe9c354a4eae885edf81f9b30
