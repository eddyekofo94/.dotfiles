# Single source of truth for Herdr's identity on this machine. Everything that
# needs to know which Herdr this is — install.sh, herdr/verify.sh,
# verify_integrations.sh, source-build/build.sh — reads it from here rather than
# hardcoding a version or digest, so an upgrade is one edit to this file (which
# upgrade.sh makes for you) instead of a hunt through six scripts.
HERDR_SOURCE_REPOSITORY=https://github.com/ogulcancelik/herdr.git

# What `herdr --version` prints for the release tracked below.
HERDR_VERSION=0.8.0

# The official upstream release binary for this version: what install.sh
# downloads when no reviewed source build is supplied, and the artifact
# herdr/verify.sh uses as a fixture when it exercises atomic replacement.
HERDR_OFFICIAL_ASSET=herdr-macos-aarch64
HERDR_OFFICIAL_SHA256=d53a9f93fccfdfcc55632927bf51002f5add0aa7990bcdf508ffbd84ac658178
HERDR_SOURCE_TAG=v0.8.0
HERDR_SOURCE_TAG_OBJECT=857196dee1ce98df53efdd3f437aa2ac8a75b608
HERDR_SOURCE_COMMIT=346411fa21afd297f5ed3b3fa56f9e3fbf7654b7
HERDR_RUST_TOOLCHAIN=1.96.1
HERDR_ZIG_VERSION=0.15.2
# The private patch series, in apply order. One file per reviewed change: each
# can be re-reviewed or dropped on its own at the next upstream tag. Each file
# owns a disjoint set of source paths, which build.sh checks against the paths
# the patched tree actually modifies. Apply order no longer has to match the
# sorted order `git diff` emits — see HERDR_TREE_DIFF_SHA256 below.
HERDR_PATCH_SERIES="copy-mode-vim-muscle-memory.patch toast-triage-colours-mobile.patch agent-panel-active-highlight.patch toast-triage-colours-status.patch working-spinner-tick.patch"

# Digest of the patch files concatenated in HERDR_PATCH_SERIES order: tamper
# detection for the files themselves, before any of them is applied.
HERDR_PATCH_SHA256=363155b6a838dbb96b8111d6ac0c1b5bfa01616687d3905cd9a88c9ad3eaa03a
# Digest of `git diff --binary` over the patched tree. Pinned separately from
# the concatenation above so a patch file may own any set of paths instead of a
# range that happens to be contiguous in sorted order. build.sh checks path
# ownership explicitly instead.
HERDR_TREE_DIFF_SHA256=c628885f2d4b97f733fdcd46d17f02372b986ee0ef2f88a65f28ab4586278614
HERDR_PATCHED_SOURCE_SHA256=11691da460aabfab0ec5bb38eb52ef8ddb4415dc865984639881c1e94f69881c
HERDR_BINARY_SHA256=943e435247288ce23520af17b3dff4f1d6cac73ba871af51f926810db243936a
