+    /// True when the last frame put a surface carrying agent state dots on
+    /// screen. The compact collapsed sidebar still draws them, so this cannot
+    /// key off `sidebar_collapsed`; only `SidebarCollapsedModeConfig::Hidden`
+    /// leaves a zero-width sidebar rect. Mobile is a width-derived view of the
+    /// same state rather than a separate client, so its header counts too.
+    pub(crate) fn working_dots_visible(&self) -> bool {
+        self.state.view.sidebar_rect.width > 0 || self.state.view.mobile_header_rect.height > 0
+    }
+
+    /// Arms the redraw tick that lets the Working spinner advance, and reports
+    /// whether this call moved it.
+    ///
+    /// Both scheduling loops must call this: `App::handle_scheduled_tasks` for a
+    /// directly attached terminal, and `handle_scheduled_tasks_headless` for the
+    /// client/server deployment, which is the one that actually runs day to day.
+    /// An earlier attempt armed the deadline in `App` alone; the headless server
+    /// never calls that function, so the spinner was dead in the real build and
+    /// the feature was reverted. One helper, two callers, so they cannot drift.
+    ///
+    /// Cleared when nothing is Working or no client can see a dot, so an idle
+    /// session and a hidden sidebar both cost nothing.
+    pub(crate) fn sync_working_spinner_deadline(
+        &mut self,
+        now: Instant,
+        dots_visible: bool,
+    ) -> bool {
+        let animating = dots_visible
+            && self
+                .state
+                .terminals
+                .values()
+                .any(|terminal| terminal.state == crate::detect::AgentState::Working);
+        if !animating {
+            self.spinner_deadline = None;
+            return false;
+        }
+        if self.spinner_deadline.is_none_or(|deadline| now >= deadline) {
+            self.spinner_deadline = Some(now + super::WORKING_SPINNER_TICK_INTERVAL);
+            return true;
+        }
+        false
+    }
