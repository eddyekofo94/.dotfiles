+    #[test]
+    fn working_spinner_tick_arms_in_the_headless_scheduled_tasks() {
+        let mut server = headless_server_with_working_agent();
+        attach_test_app_client(&mut server);
+
+        let now = Instant::now();
+        assert!(server.handle_scheduled_tasks_headless(now, false));
+        let armed = server.app.spinner_deadline.expect("spinner deadline armed");
+        assert_eq!(armed, now + crate::app::WORKING_SPINNER_TICK_INTERVAL);
+
+        assert!(!server.handle_scheduled_tasks_headless(now, false));
+        assert_eq!(server.app.spinner_deadline, Some(armed));
+
+        assert!(server.handle_scheduled_tasks_headless(armed, false));
+        assert_eq!(
+            server.app.spinner_deadline,
+            Some(armed + crate::app::WORKING_SPINNER_TICK_INTERVAL)
+        );
+    }
