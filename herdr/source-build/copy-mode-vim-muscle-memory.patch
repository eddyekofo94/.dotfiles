     draw_host_cursor: bool,
+    /// Client-owned blink phase for native cursors. Outer terminal output can
+    /// otherwise keep restarting the host's blink timer during agent animation.
+    host_cursor_blink: HostCursorBlink,
+}
+
+const HOST_CURSOR_BLINK_INTERVAL: Duration = Duration::from_millis(500);
+
+#[derive(Debug)]
+struct HostCursorBlink {
+    visible: bool,
+    next_toggle: Option<std::time::Instant>,
+    focused: bool,
+    source_cursor: Option<(u8, bool)>,
+}
+
+impl Default for HostCursorBlink {
+    fn default() -> Self {
+        Self {
+            visible: true,
+            next_toggle: None,
+            focused: true,
+            source_cursor: None,
+        }
+    }
+}
+
+impl HostCursorBlink {
+    fn observe_blinking_frame(&mut self, now: std::time::Instant) {
+        self.next_toggle
+            .get_or_insert(now + HOST_CURSOR_BLINK_INTERVAL);
+    }
+
+    fn prepare_frame(&mut self, frame: &mut protocol::FrameData, now: std::time::Instant) {
+        let Some(cursor) = frame.cursor.as_mut() else {
+            self.reset();
+            return;
+        };
+
+        self.source_cursor = Some((cursor.shape, cursor.visible));
+        cursor.shape = steady_cursor_shape(cursor.shape);
+        if !self.focused {
+            self.reset_phase();
+            return;
+        }
+
+        self.observe_blinking_frame(now);
+        let _ = self.tick(now);
+        cursor.visible = self.visible;
+    }
+
+    fn tick(&mut self, now: std::time::Instant) -> Option<bool> {
+        let deadline = self.next_toggle?;
+        if now < deadline {
+            return None;
+        }
+
+        self.visible = !self.visible;
+        self.next_toggle = Some(now + HOST_CURSOR_BLINK_INTERVAL);
+        Some(self.visible)
+    }
+
+    fn reset(&mut self) {
+        self.source_cursor = None;
+        self.reset_phase();
+    }
+
+    fn reset_phase(&mut self) {
+        self.visible = true;
+        self.next_toggle = None;
+    }
+
+    fn set_focused(&mut self, focused: bool) -> Option<(u8, bool)> {
+        self.focused = focused;
+        self.reset_phase();
+        (!focused)
+            .then(|| {
+                self.source_cursor
+                    .map(|(shape, visible)| (steady_cursor_shape(shape), visible))
+            })
+            .flatten()
+    }
+}
+
+fn steady_cursor_shape(shape: u8) -> u8 {
+    match shape {
+        0 | 1 => 2,
+        3 => 4,
+        5 => 6,
+        2 | 4 | 6 => shape,
+        _ => 2,
+    }
 }
 
