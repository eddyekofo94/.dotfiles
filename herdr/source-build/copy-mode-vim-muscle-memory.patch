diff --git a/src/app/state.rs b/src/app/state.rs
index f8395cbd..5a6c30dd 100644
--- a/src/app/state.rs
+++ b/src/app/state.rs
@@ -939,6 +939,39 @@ pub(crate) struct CopyModeState {
     pub entry_offset_from_bottom: usize,
     pub selection: Option<CopyModeSelection>,
     pub search: CopyModeSearchState,
+    pub pending: CopyModePending,
+}
+
+/// Vim's pending-command buffer: the count typed before a motion (`2j`) and the
+/// first key of a multi-key sequence (`z` of `zz`). Esc discards it without
+/// touching the selection, exactly as Vim discards a half-typed command.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub(crate) struct CopyModePending {
+    pub count: Option<u32>,
+    pub operator: Option<char>,
+}
+
+impl CopyModePending {
+    pub fn is_active(&self) -> bool {
+        self.count.is_some() || self.operator.is_some()
+    }
+
+    /// The repeat count a motion should use; 1 when nothing was typed.
+    pub fn repeat(&self) -> u32 {
+        self.count.unwrap_or(1).max(1)
+    }
+
+    /// What the copy-mode overlay echoes back, mirroring Vim's pending display.
+    pub fn display(&self) -> String {
+        let mut text = String::new();
+        if let Some(count) = self.count {
+            text.push_str(&count.to_string());
+        }
+        if let Some(operator) = self.operator {
+            text.push(operator);
+        }
+        text
+    }
 }
 
