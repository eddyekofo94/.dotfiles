+    /// Run a copy-mode operation `count` times, stopping early if copy mode is
+    /// left in the middle (a motion can close a vanished pane).
+    fn repeat_copy_mode(&mut self, count: u32, mut op: impl FnMut(&mut Self)) {
+        for _ in 0..count {
+            if self.copy_mode.is_none() {
+                return;
+            }
+            op(self);
+        }
+    }
+
+    fn repeat_copy_cursor(
+        &mut self,
+        terminal_runtimes: &TerminalRuntimeRegistry,
+        row_delta: i16,
+        col_delta: i16,
+        count: u32,
+    ) {
+        self.repeat_copy_mode(count, |state| {
+            state.move_copy_cursor(terminal_runtimes, row_delta, col_delta)
+        });
+    }
+
+    fn repeat_copy_mode_page(
+        &mut self,
+        terminal_runtimes: &TerminalRuntimeRegistry,
+        direction: i16,
+        half_page: bool,
+        count: u32,
+    ) {
+        self.repeat_copy_mode(count, |state| {
+            state.scroll_copy_mode_page(terminal_runtimes, direction, half_page)
+        });
+    }
+
+    /// Select `count` whole lines starting at the cursor line, composing the
+    /// existing single-line selector with the existing downward motion so the
+    /// result is identical to `V` followed by `j` that many times.
+    fn select_copy_mode_lines(&mut self, terminal_runtimes: &TerminalRuntimeRegistry, count: u32) {
+        self.select_copy_mode_line(terminal_runtimes);
+        self.repeat_copy_cursor(terminal_runtimes, 1, 0, count.saturating_sub(1));
+    }
+
+    fn yank_copy_mode_lines(&mut self, terminal_runtimes: &TerminalRuntimeRegistry, count: u32) {
+        self.select_copy_mode_lines(terminal_runtimes, count);
+        self.exit_copy_mode(terminal_runtimes, true);
+    }
+
+    /// Vim's `zz`: scroll the pane so the cursor's text line sits on the middle
+    /// viewport row, leaving the cursor on the same line it was already on.
+    fn center_copy_mode_cursor(&mut self, terminal_runtimes: &TerminalRuntimeRegistry) {
+        let Some(copy_mode) = self.copy_mode.as_ref() else {
+            return;
+        };
+        let pane_id = copy_mode.pane_id;
+        let cursor_row = copy_mode.cursor_row;
+        let Some(info) = self.pane_info_by_id(pane_id).cloned() else {
+            self.exit_copy_mode(terminal_runtimes, false);
+            return;
+        };
+        let height = info.inner_rect.height;
+        if height == 0 {
+            return;
+        }
+        let target_row = height.saturating_sub(1) / 2;
+        if target_row == cursor_row {
+            return;
+        }
+
+        let next_cursor_row = if cursor_row > target_row {
+            // Cursor below centre: show newer lines, which lowers the offset.
+            let lines = usize::from(cursor_row - target_row);
+            match self.pane_scroll_metrics(terminal_runtimes, pane_id) {
+                Some(metrics) => {
+                    let applied = lines.min(metrics.offset_from_bottom);
+                    self.set_pane_scroll_offset(
+                        terminal_runtimes,
+                        pane_id,
+                        metrics.offset_from_bottom - applied,
+                    );
+                    cursor_row.saturating_sub(applied.min(u16::MAX as usize) as u16)
+                }
+                None => {
+                    self.scroll_pane_down(terminal_runtimes, pane_id, lines);
+                    target_row
+                }
+            }
+        } else {
+            // Cursor above centre: show older lines, which raises the offset.
+            let lines = usize::from(target_row - cursor_row);
+            match self.pane_scroll_metrics(terminal_runtimes, pane_id) {
+                Some(metrics) => {
+                    let room = metrics
+                        .max_offset_from_bottom
+                        .saturating_sub(metrics.offset_from_bottom);
+                    let applied = lines.min(room);
+                    self.set_pane_scroll_offset(
+                        terminal_runtimes,
+                        pane_id,
+                        metrics.offset_from_bottom.saturating_add(applied),
+                    );
+                    cursor_row.saturating_add(applied.min(u16::MAX as usize) as u16)
+                }
+                None => {
+                    self.scroll_pane_up(terminal_runtimes, pane_id, lines);
+                    target_row
+                }
+            }
+        };
+
+        if let Some(copy_mode) = self.copy_mode.as_mut() {
+            copy_mode.cursor_row = next_cursor_row.min(height.saturating_sub(1));
+        }
+        self.sync_copy_mode_selection(terminal_runtimes);
+    }
