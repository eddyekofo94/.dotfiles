+
+        let (mut direct, _) = app_with_copy_screen(b"alpha\r\nbeta\r\n");
+        direct
+            .state
+            .enter_copy_mode_search(&direct.terminal_runtimes, CopyModeSearchDirection::Backward);
+        let actual = direct
+            .state
+            .copy_mode
+            .as_ref()
+            .and_then(|copy_mode| copy_mode.search.prompt.clone())
+            .expect("direct prompt is open");
+
+        assert_eq!(actual, expected);
+    }
