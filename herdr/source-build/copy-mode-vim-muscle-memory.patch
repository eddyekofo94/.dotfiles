+    /// Absorb a key into the pending-command buffer. Returns `true` when the
+    /// key belonged to the buffer rather than to a copy-mode command: a count
+    /// digit, the `z` that opens a `z` sequence, or the Esc that discards a
+    /// half-typed command without disturbing the selection or search.
+    fn accumulate_copy_mode_pending(&mut self, key: TerminalKey) -> bool {
+        let Some(copy_mode) = self.copy_mode.as_mut() else {
+            return false;
+        };
+        if key.code == KeyCode::Esc {
+            if !copy_mode.pending.is_active() {
+                return false;
+            }
+            copy_mode.pending = CopyModePending::default();
+            return true;
+        }
+        if copy_mode.pending.operator.is_some() {
+            return false;
+        }
+        let Some(ch) = copy_mode_command_char(key) else {
+            return false;
+        };
+        if ch == 'z' {
+            copy_mode.pending.operator = Some('z');
+            return true;
+        }
+        let Some(digit) = ch.to_digit(10) else {
+            return false;
+        };
+        // A leading `0` is the line-edge motion, not a count, exactly as in Vim.
+        if digit == 0 && copy_mode.pending.count.is_none() {
+            return false;
+        }
+        let next = copy_mode
+            .pending
+            .count
+            .unwrap_or(0)
+            .saturating_mul(10)
+            .saturating_add(digit)
+            .min(COPY_MODE_MAX_COUNT);
+        copy_mode.pending.count = Some(next);
+        true
+    }
+
+    fn take_copy_mode_pending(&mut self) -> CopyModePending {
+        self.copy_mode
+            .as_mut()
+            .map(|copy_mode| std::mem::take(&mut copy_mode.pending))
+            .unwrap_or_default()
+    }
+
+    fn copy_mode_selection(&self) -> Option<CopyModeSelection> {
