+    #[test]
+    fn agent_focus_keeps_the_focused_agent_visible_in_agent_panel() {
+        let mut app = app_with_agent();
+        for idx in 1..8 {
+            app.state.workspaces[0].test_add_tab(Some(&format!("tab-{idx}")));
+        }
+        app.state.ensure_test_terminals();
+        for tab in &app.state.workspaces[0].tabs {
+            let pane_id = tab.root_pane;
+            let terminal_id = tab.panes[&pane_id].attached_terminal_id.clone();
+            app.state
+                .terminals
+                .get_mut(&terminal_id)
+                .unwrap()
+                .set_detected_state(Some(Agent::Pi), AgentState::Idle);
+        }
+        let first = app.state.workspaces[0].tabs[0].root_pane;
+        app.state.workspaces[0].switch_tab(0);
+        app.state.workspaces[0].tabs[0].layout.focus_pane(first);
+        crate::ui::compute_view(&mut app.state, ratatui::layout::Rect::new(0, 0, 80, 14));
+        assert_eq!(app.state.agent_panel_scroll, 0);
+
+        let last_tab = app.state.workspaces[0].tabs.len() - 1;
+        let last = app.state.workspaces[0].tabs[last_tab].root_pane;
+        let response = app.handle_agent_focus(
+            "req".into(),
+            AgentTarget {
+                target: app.public_pane_id(0, last).unwrap(),
+            },
+        );
+
+        let _: SuccessResponse = serde_json::from_str(&response).unwrap();
+        assert_eq!(app.state.workspaces[0].active_tab, last_tab);
+        assert!(app.state.agent_panel_scroll > 0);
+    }
+
