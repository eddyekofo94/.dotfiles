<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. install_tab_status.sh renders @PLACEHOLDERS@ and writes the result
  to ~/Library/LaunchAgents; a launchd plist cannot expand $HOME itself, so the
  paths have to be baked in per machine and this file stays checkout-portable.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@LABEL@</string>

  <!-- Watch mode skips a pass when no Herdr server is up, so this agent can
       start at login and simply wait for the first `herdr` of the day. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@SCRIPT@</string>
    <string>--watch</string>
    <string>@INTERVAL@</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart if the script ever dies; ThrottleInterval caps the respawn rate
       if it dies immediately (a missing jq, say). -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <!-- launchd hands a user agent a bare PATH: herdr lives in ~/.local/bin and
       jq in Homebrew, and neither is on it. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@BIN_DIR@:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>@LOG@</string>
  <key>StandardErrorPath</key>
  <string>@LOG@</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
